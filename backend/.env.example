# DevPilot Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or credentials to Git.

# Application Environment (development | production)
APP_ENV=development

# GitHub OAuth Application (Required for user authentication)
# Create at: https://github.com/settings/developers
# Authorization callback URL: http://127.0.0.1:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Server-Side GitHub Personal Access Token (Optional background fallback)
# Used only when a user is not signed in via OAuth
GITHUB_TOKEN=ghp_your_optional_server_github_token

# Session Encryption Key (Required for encrypting OAuth tokens at rest)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=your_random_secret_encryption_key_here

# AI Model Provider Keys (Optional: DevPilot falls back to rule-based heuristics if omitted)
# Google Gemini API: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Groq Cloud API: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
